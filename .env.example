# Required
BOT_TOKEN=123456:replace_me
SUPPORT_CHAT_ID=-1001234567890

# Recommended
WEBHOOK_SECRET=replace_with_long_random_secret
ENCRYPTION_SECRET=replace_with_at_least_16_chars_random_secret
ADMIN_PASSWORD=replace_with_strong_password
PUBLIC_URL=https://bot.example.com

# Server runtime
HOST=0.0.0.0
PORT=3000
SQLITE_PATH=./data/telegram-support-bot.sqlite

# Optional admins / bot info
OWNER_IDS=123456789,987654321
BOT_USERNAME=your_bot_username
DEFAULT_LANG=zh-CN

# Optional rate limit
RATE_LIMIT_COUNT=8
RATE_LIMIT_WINDOW_SECONDS=60
SUPPORT_CARD_FALLBACK=true

# Optional AI
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=
AI_AUTO_REPLY=false

# Optional audio transcoding
# Node/VPS can use local ffmpeg automatically when installed.
# Cloudflare Workers/Pages cannot run ffmpeg; set AUDIO_TRANSCODE_URL to an external service if MP3 playback is required.
AUDIO_TRANSCODE_URL=
AUDIO_TRANSCODE_SECRET=
